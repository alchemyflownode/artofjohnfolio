{
  "schema": "aoj.qr/v1",
  "$comment": "The permanent resolution layer. A QR prints a PUBLIC PATH (/q/...), never a website route. The path is mapped here to an entity; the website route is a second indirection the site is free to change. Re-pointing a public path at a DIFFERENT entity is the one change this layer forbids, and data/qr-identity-lock.json makes any such change fail the gate.",
  "publicPathPrefix": "/q",
  "destinationPolicy": {
    "sameOrigin": true,
    "allowedDestinationPrefixes": [
      "/"
    ],
    "forbidden": [
      "absolute http(s) destinations",
      "protocol-relative //host",
      "paths escaping the site root",
      "percent-encoded separators (%2f, %5c)",
      "backslashes"
    ]
  },
